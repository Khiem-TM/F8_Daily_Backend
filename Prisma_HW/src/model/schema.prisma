generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  price       Float
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@map("product")
}